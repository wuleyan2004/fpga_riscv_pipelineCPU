# Pangu 676 full-size baseboard + PG2L200H 676-pin core board.
# Top module: board_top (源代码/board_top.v); source list: board_sources.f.
# Three-stage pipeline CPU with WB -> EX forwarding.
# Evidence: MES2L676-100HP-BASE-V1.2 schematic, J3/USER_LED/USER_BUTTON;
#           MES2L676-100HP-CORE-V1.2 schematic, PG2L200H L3 pin map.
# Remote FPGA LAB UART is routed through its instrument at AB26, not through
# the baseboard CP2102 pin C24. Other board I/O still needs on-board checking.
# This file is for the supplied full-size baseboard schematics, not a MINI board.
# Select the exact remote FPGA device/package before implementation.

# Core-board 27 MHz oscillator, FPGA_GCLK_27M -> D18.
create_clock -name {clk} -period {37.037} [get_ports {clk}]
define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}

# USER_BUTTON0: active-low reset; asynchronous assertion, synchronized release.
define_attribute {p:reset_button_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:reset_button_n} {PAP_IO_LOC} {C22}
define_attribute {p:reset_button_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:reset_button_n} {PAP_IO_STANDARD} {LVCMOS33}

# USER_BUTTON1..4: active-low inputs, mapped to GPIO_IN[0..3].
define_attribute {p:gpio_button_n[0]} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:gpio_button_n[0]} {PAP_IO_LOC} {C23}
define_attribute {p:gpio_button_n[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_button_n[0]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_button_n[1]} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:gpio_button_n[1]} {PAP_IO_LOC} {B22}
define_attribute {p:gpio_button_n[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_button_n[1]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_button_n[2]} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:gpio_button_n[2]} {PAP_IO_LOC} {A22}
define_attribute {p:gpio_button_n[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_button_n[2]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_button_n[3]} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:gpio_button_n[3]} {PAP_IO_LOC} {B20}
define_attribute {p:gpio_button_n[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_button_n[3]} {PAP_IO_STANDARD} {LVCMOS33}

# USER_LED0..7: high level lights the LED on the supplied baseboard.
define_attribute {p:gpio_out[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[0]} {PAP_IO_LOC} {A20}
define_attribute {p:gpio_out[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[0]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[1]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[1]} {PAP_IO_LOC} {C18}
define_attribute {p:gpio_out[1]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[1]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[2]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[2]} {PAP_IO_LOC} {C19}
define_attribute {p:gpio_out[2]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[2]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[3]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[3]} {PAP_IO_LOC} {E18}
define_attribute {p:gpio_out[3]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[3]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[4]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[4]} {PAP_IO_LOC} {A17}
define_attribute {p:gpio_out[4]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[4]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[5]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[5]} {PAP_IO_LOC} {A18}
define_attribute {p:gpio_out[5]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[5]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[6]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[6]} {PAP_IO_LOC} {C17}
define_attribute {p:gpio_out[6]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[6]} {PAP_IO_STANDARD} {LVCMOS33}

define_attribute {p:gpio_out[7]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:gpio_out[7]} {PAP_IO_LOC} {B17}
define_attribute {p:gpio_out[7]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:gpio_out[7]} {PAP_IO_STANDARD} {LVCMOS33}

# Remote FPGA LAB serial receive input: FPGA TX -> AB26 (115200 8N1).
define_attribute {p:uart_tx_pin} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx_pin} {PAP_IO_LOC} {AB26}
define_attribute {p:uart_tx_pin} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx_pin} {PAP_IO_STANDARD} {LVCMOS33}

# External buttons have no phase relationship to clk. The raw GPIO ports
# feed only the first synchronizer stage; reset feeds the reset synchronizer.
# These exceptions do NOT cut the clocked paths between synchronizer stages
# or the internal reset/CPU/forwarding paths, which remain timed at 27 MHz.
set_false_path -from [get_ports {reset_button_n}]
set_false_path -from [get_ports {gpio_button_n*}]

# LEDs and UART TX are asynchronous external endpoints, with no receiving
# clock exported by this design. Internal output-register paths remain timed.
set_false_path -to [get_ports {gpio_out*}]
set_false_path -to [get_ports {uart_tx_pin}]
